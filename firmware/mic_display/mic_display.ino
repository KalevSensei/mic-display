// Mic-stand audio display: Waveshare ESP32-S3-Touch-AMOLED-1.75 (466 x 466 round AMOLED, CO5300 over QSPI).
// Draws the same dial as companion/index.html from the lines the page sends over USB.
// Shows only what the PC can read (owner, 2026-11-14: no light sensor). Display only: touch is not used,
// nothing is sent back.
//
// Sources for the pins, the display init and the toolchain (read 2026-11-15):
//   Waveshare wiki:   https://www.waveshare.com/wiki/ESP32-S3-Touch-AMOLED-1.75
//   Waveshare demos:  https://github.com/waveshareteam/ESP32-S3-Touch-AMOLED-1.75 (commit e4344e7)
//     examples/arduino/01_HelloWorld/01_HelloWorld.ino           display init (Arduino_ESP32QSPI + Arduino_CO5300)
//     examples/arduino/libraries/Mylibrary/pin_config.h           pins below
//     docs/getting-started.md, HARDWARE_REFERENCE.md              core 3.3.10, 16 MB flash, app3M_fat9M_16MB,
//                                                                 ESP32-S3R8 (8 MB octal PSRAM), no backlight pin
// The display needs no power-chip step: Waveshare's display demos never touch the AXP2101 (its default rails
// power the panel), so this sketch does not either.
//
// Build (docs/PLAN.md M03 has the beginner steps):
//   esp32 core 3.3.10 (Espressif), board "ESP32S3 Dev Module", Flash Size 16MB, Partition Scheme
//   "16M Flash (3MB APP/9.9MB FATFS)", PSRAM "OPI PSRAM", USB CDC On Boot "Enabled".
//   Library: Waveshare's bundled copy of "GFX Library for Arduino" 1.6.4 (moononournation), from
//   examples/arduino/libraries/GFX_Library_for_Arduino in Waveshare's repository (patched for core 3.3.10).
//   arduino-cli FQBN: esp32:esp32:esp32s3:FlashSize=16M,PartitionScheme=app3M_fat9M_16MB,PSRAM=opi,CDCOnBoot=cdc
//
// Protocol, page -> display, one line per frame (unchanged):
//   S,<level dB x10>,<peak dB x10>,<clip 0|1>,<rec 0|1|2>,<sample rate Hz>,<device name>\n

#include <Arduino_GFX_Library.h>
#include <esp_heap_caps.h>
#include <math.h>
#include "fonts.h"   // IBM Plex, the page's typefaces (generated by firmware/tools/make_fonts.py)

// ---- pins (Waveshare pin_config.h) ----
#define LCD_SDIO0 4
#define LCD_SDIO1 5
#define LCD_SDIO2 6
#define LCD_SDIO3 7
#define LCD_SCLK 38
#define LCD_CS 12
#define LCD_RESET 39
#define LCD_WIDTH 466
#define LCD_HEIGHT 466

// ---- display init, as in Waveshare's 01_HelloWorld ----
Arduino_DataBus *bus = new Arduino_ESP32QSPI(LCD_CS, LCD_SCLK, LCD_SDIO0, LCD_SDIO1, LCD_SDIO2, LCD_SDIO3);
Arduino_CO5300 *panel = new Arduino_CO5300(bus, LCD_RESET, 0 /* rotation */, LCD_WIDTH, LCD_HEIGHT, 6, 0, 0, 0);
const uint8_t BRIGHTNESS = 200;   // 0..255; Waveshare's demos use 128..255

// Whole frame drawn off-screen in PSRAM (466 x 466 x 2 = 434 KB), then pushed in one go: no flicker.
const int W = LCD_WIDTH, H = LCD_HEIGHT;
uint16_t *fb = nullptr;

// ---- dial design: the page's 240 px layout, scaled by K ----
const float K = 466.0f / 240.0f;
const float C = 233.0f;   // centre (pixel edges 0..466)
const float MIN_DB = -60, MAX_DB = 0, ARC_FROM = 150, ARC_TO = 390;   // degrees, from lower left over the top to lower right
uint16_t rgb(uint8_t r, uint8_t g, uint8_t b) { return ((r & 0xF8) << 8) | ((g & 0xFC) << 3) | (b >> 3); }
const uint16_t TEXT = rgb(0xf2, 0xf4, 0xf7), DIM = rgb(0x7d, 0x87, 0x94), NEEDLE = 0xFFFF;
const uint16_t GREEN = rgb(0x2e, 0xcc, 0x71), AMBER = rgb(0xf5, 0xb3, 0x01), RED = rgb(0xff, 0x3b, 0x30);
const uint16_t GREEN_D = rgb(0x16, 0x50, 0x2f), AMBER_D = rgb(0x5a, 0x43, 0x00), RED_D = rgb(0x5c, 0x16, 0x12);

// ---- anti-aliased drawing into fb ----
static inline float clamp01(float v) { return v < 0 ? 0 : (v > 1 ? 1 : v); }
static inline void blend(int x, int y, uint16_t c, uint32_t a /* 0..256 */) {
  if (a == 0 || (unsigned)x >= (unsigned)W || (unsigned)y >= (unsigned)H) return;
  uint16_t *p = fb + y * W + x;
  if (a >= 256) { *p = c; return; }
  uint32_t d = *p;
  int r = (d >> 11) + ((((int)(c >> 11) - (int)(d >> 11)) * (int)a) >> 8);
  int g = ((d >> 5) & 63) + ((((int)((c >> 5) & 63) - (int)((d >> 5) & 63)) * (int)a) >> 8);
  int b = (d & 31) + ((((int)(c & 31) - (int)(d & 31)) * (int)a) >> 8);
  *p = (r << 11) | (g << 5) | b;
}
static inline void cover(int x, int y, uint16_t c, float cov) { blend(x, y, c, (uint32_t)(cov * 256.0f + 0.5f)); }

// Ring segment between radii ri..ro from angle a0 to a1 (degrees, clockwise from 3 o'clock, like the page's
// canvas). Sweeps over 180 degrees are split; the split seams are hard so they leave no line.
void ring(float ri, float ro, float a0, float a1, uint16_t col, bool aa0 = true, bool aa1 = true) {
  if (a1 <= a0) return;
  bool full = a1 - a0 >= 360;
  if (!full && a1 - a0 > 180) { float m = (a0 + a1) / 2; ring(ri, ro, a0, m, col, aa0, false); ring(ri, ro, m, a1, col, false, aa1); return; }
  float sx = cosf(a0 * DEG_TO_RAD), sy = sinf(a0 * DEG_TO_RAD), ex = cosf(a1 * DEG_TO_RAD), ey = sinf(a1 * DEG_TO_RAD);
  // bounding box: arc end points on both radii plus any axis extreme inside the sweep
  float bx0 = C + ro, by0 = C + ro, bx1 = C - ro, by1 = C - ro;
  auto grow = [&](float x, float y) { bx0 = min(bx0, x); bx1 = max(bx1, x); by0 = min(by0, y); by1 = max(by1, y); };
  if (full) { grow(C - ro, C - ro); grow(C + ro, C + ro); }
  else {
    for (float r : {ri, ro}) { grow(C + sx * r, C + sy * r); grow(C + ex * r, C + ey * r); }
    for (int q = 0; q <= 720; q += 90) if (q > a0 && q < a1) grow(C + cosf(q * DEG_TO_RAD) * ro, C + sinf(q * DEG_TO_RAD) * ro);
  }
  int y0 = max(0, (int)floorf(by0 - 1)), y1 = min(H - 1, (int)ceilf(by1 + 1));
  int x0 = max(0, (int)floorf(bx0 - 1)), x1 = min(W - 1, (int)ceilf(bx1 + 1));
  float ri2 = (ri - 0.5f) * (ri - 0.5f), ro2 = (ro + 0.5f) * (ro + 0.5f);
  float in2 = (ri + 0.5f) * (ri + 0.5f), out2 = (ro - 0.5f) * (ro - 0.5f);
  for (int y = y0; y <= y1; y++) {
    float py = y + 0.5f - C, py2 = py * py;
    if (py2 > ro2) continue;
    // visit only the ring: the outer circle's chord minus the inner circle's chord
    float ho = sqrtf(ro2 - py2), hi = py2 < ri2 ? sqrtf(ri2 - py2) : 0;
    int xa = max(x0, (int)floorf(C - ho)), xb = min(x1, (int)ceilf(C + ho));
    int ia = (int)ceilf(C - hi) + 1, ib = (int)floorf(C + hi) - 2;   // fully inside the hole
    for (int x = xa; x <= xb; x++) {
      if (x >= ia && x <= ib) { x = ib; continue; }
      float px = x + 0.5f - C, d2 = px * px + py2;
      if (d2 < ri2 || d2 > ro2) continue;
      float cov = 1;
      if (d2 < in2 || d2 > out2) { float d = sqrtf(d2); cov = clamp01(d - ri + 0.5f) * clamp01(ro - d + 0.5f); }
      if (!full) {
        float cs = sx * py - sy * px, ce = px * ey - py * ex;   // distance past the start ray / before the end ray
        if (cs < -0.5f || ce < -0.5f) continue;
        if (aa0) cov *= clamp01(cs + 0.5f); else if (cs < 0) continue;
        if (aa1) cov *= clamp01(ce + 0.5f); else if (ce < 0) continue;
      }
      cover(x, y, col, cov);
    }
  }
}
void disc(float cx, float cy, float r, uint16_t col) {
  for (int y = max(0, (int)floorf(cy - r - 1)); y <= min(H - 1, (int)ceilf(cy + r + 1)); y++)
    for (int x = max(0, (int)floorf(cx - r - 1)); x <= min(W - 1, (int)ceilf(cx + r + 1)); x++) {
      float dx = x + 0.5f - cx, dy = y + 0.5f - cy;
      cover(x, y, col, clamp01(r + 0.5f - sqrtf(dx * dx + dy * dy)));
    }
}
// Line of half-width hw from (ax,ay) to (bx,by); round or butt ends, like the page's lineCap.
void line(float ax, float ay, float bx, float by, float hw, bool round, uint16_t col) {
  float dx = bx - ax, dy = by - ay, len = sqrtf(dx * dx + dy * dy);
  if (len < 0.01f) return;
  dx /= len; dy /= len;
  float m = hw + 1;
  int y0 = max(0, (int)floorf(min(ay, by) - m)), y1 = min(H - 1, (int)ceilf(max(ay, by) + m));
  int x0 = max(0, (int)floorf(min(ax, bx) - m)), x1 = min(W - 1, (int)ceilf(max(ax, bx) + m));
  for (int y = y0; y <= y1; y++)
    for (int x = x0; x <= x1; x++) {
      float px = x + 0.5f - ax, py = y + 0.5f - ay;
      float s = fabsf(px * dy - py * dx);
      if (s > m) continue;
      float t = px * dx + py * dy, cov;
      if (round) {
        float d = t < 0 ? sqrtf(px * px + py * py) : t > len ? sqrtf((t - len) * (t - len) + s * s) : s;
        cov = clamp01(hw + 0.5f - d);
      } else cov = clamp01(hw + 0.5f - s) * clamp01(t + 0.5f) * clamp01(len - t + 0.5f);
      cover(x, y, col, cov);
    }
}

// ---- text: UTF-8, centred on x, y = baseline (the page's textAlign 'center', alphabetic baseline) ----
uint32_t nextCp(const char *&s) {
  uint8_t c = *s++;
  if (c < 0x80) return c;
  int n = c >= 0xF0 ? 3 : c >= 0xE0 ? 2 : c >= 0xC0 ? 1 : -1;
  if (n < 0) return '?';
  uint32_t cp = c & (0x3F >> n);
  while (n--) { if ((*s & 0xC0) != 0x80) return '?'; cp = (cp << 6) | (*s++ & 0x3F); }
  return cp;
}
const MDGlyph *glyph(const MDFont &f, uint32_t cp) {
  int lo = 0, hi = f.count - 1;
  while (lo <= hi) { int m = (lo + hi) / 2; if (f.glyphs[m].code == cp) return &f.glyphs[m]; if (f.glyphs[m].code < cp) lo = m + 1; else hi = m - 1; }
  return cp == '?' ? nullptr : glyph(f, '?');
}
float textWidth(const MDFont &f, const char *s) {
  uint32_t w4 = 0;
  while (*s) { const MDGlyph *g = glyph(f, nextCp(s)); if (g) w4 += g->adv4; }
  return w4 / 4.0f;
}
void textAt(const MDFont &f, const char *s, float x, int baseline, uint16_t col) {
  float pen = x;
  while (*s) {
    const MDGlyph *g = glyph(f, nextCp(s));
    if (!g) continue;
    const uint8_t *bits = f.bits + g->offset;
    int gx = (int)lroundf(pen) + g->x, gy = baseline + g->y;
    for (int i = 0, n = g->w * g->h; i < n; i++) {
      uint8_t a = (bits[i >> 1] >> ((i & 1) ? 0 : 4)) & 15;
      if (a) blend(gx + i % g->w, gy + i / g->w, col, a * 17 + (a * 17 >> 7));   // 15 -> 256
    }
    pen += g->adv4 / 4.0f;
  }
}
void centered(const MDFont &f, const char *s, float x, float baseline, uint16_t col) {
  textAt(f, s, x - textWidth(f, s) / 2, (int)lroundf(baseline), col);
}

// ---- state from the page ----
float level = MIN_DB, peak = MIN_DB;
int clip = 0, rec = 0;
long rate = 0;
char name[64] = "";            // up to 22 characters, UTF-8
uint32_t lastFrame = 0;        // millis() of the last S line
uint32_t loudAt = 0;           // millis() when the level was last above the no-signal floor
const float SILENT_DB = -55;   // below this for 3 s = NO SIGNAL (e.g. the Yeti's own mute button)

float dbToDeg(float db) { return ARC_FROM + (constrain(db, MIN_DB, MAX_DB) - MIN_DB) / (MAX_DB - MIN_DB) * (ARC_TO - ARC_FROM); }
void zone(float fromDb, float toDb, uint16_t col) { ring(95 * K, 105 * K, dbToDeg(fromDb), dbToDeg(toDb), col); }   // page: r 100, width 10

void draw() {
  memset(fb, 0, W * H * 2);   // background #000000
  uint32_t now = millis();
  bool live = lastFrame && now - lastFrame < 2000;
  if (clip && live) ring(113 * K, 119 * K, 0, 360, RED);   // page: r 116, width 6
  if (!live) { centered(F_MSG, "waiting for PC", C, C + 6 * K, DIM); return; }

  // zones, then the lit part up to the level
  zone(-60, -18, GREEN_D); zone(-18, -6, AMBER_D); zone(-6, 0, RED_D);
  if (level > -60) zone(-60, min(level, -18.0f), GREEN);
  if (level > -18) zone(-18, min(level, -6.0f), AMBER);
  if (level > -6) zone(-6, min(level, 0.0f), RED);

  // ticks and labels (-18 is a tick only: the zone edge)
  const int ticks[] = {-60, -48, -36, -24, -18, -12, -6, 0};
  for (int db : ticks) {
    float a = dbToDeg(db) * DEG_TO_RAD, ca = cosf(a), sa = sinf(a);
    line(C + ca * 88 * K, C + sa * 88 * K, C + ca * 81 * K, C + sa * 81 * K, 1 * K, false, DIM);
    if (db != -18) { char t[5]; snprintf(t, sizeof t, "%d", db); centered(F_SMALL, t, C + ca * 70 * K, C + (sa * 70 + 4) * K, DIM); }
  }
  // peak marker
  if (peak > MIN_DB) { float a = dbToDeg(peak) * DEG_TO_RAD; disc(C + cosf(a) * 100 * K, C + sinf(a) * 100 * K, 4 * K, peak > -6 ? RED : TEXT); }
  // needle: 3 px wide, round caps, from 10 behind the centre to 92 out; hub r 6
  float a = dbToDeg(level) * DEG_TO_RAD, ca = cosf(a), sa = sinf(a);
  line(C - ca * 10 * K, C - sa * 10 * K, C + ca * 92 * K, C + sa * 92 * K, 1.5f * K, true, NEEDLE);
  disc(C, C, 6 * K, NEEDLE);

  // readout; NO SIGNAL (3 s of silence, e.g. the mic's own mute button) takes the number's place
  if (now - loudAt > 3000) centered(F_WARN, "NO SIGNAL", C, C + 56 * K, AMBER);
  else {
    char t[12];
    if (level <= MIN_DB) strcpy(t, "\xE2\x80\x93\xE2\x88\x9E");   // "–∞", as on the page
    else snprintf(t, sizeof t, "%d", (int)floorf(level + 0.5f));   // JavaScript Math.round
    centered(F_BIG, t, C, C + 50 * K, TEXT);
    centered(F_SMALL, "dBFS", C, C + 64 * K, DIM);
  }
  // recording chip on top, between the -36 and -24 labels: "● REC" / "● LIVE"
  if (rec) {
    const char *t = rec == 2 ? "LIVE" : "REC";
    float dotR = 4.2f * K, gap = textWidth(F_CHIP, " "), w = 2 * dotR + gap + textWidth(F_CHIP, t);
    float x = C - w / 2, base = 44 * K;
    disc(x + dotR, base - 5 * K, dotR, RED);
    textAt(F_CHIP, t, x + 2 * dotR + gap, (int)lroundf(base), RED);
  }
  // footer: sample rate and device
  if (rate) { char t[16]; snprintf(t, sizeof t, rate % 1000 ? "%.1f kHz" : "%.0f kHz", rate / 1000.0); centered(F_SMALL, t, C, 196 * K, DIM); }
  centered(F_SMALL, name, C, 211 * K, DIM);
}

// ---- serial input ----
char lineBuf[160]; int len = 0;
void parseLine() {
  lineBuf[len] = 0; len = 0;
  if (lineBuf[0] != 'S' || lineBuf[1] != ',') return;
  char *p = lineBuf + 2; char *f[6]; int n = 0;
  f[n++] = p;
  while (*p && n < 6) { if (*p == ',') { *p = 0; f[n++] = p + 1; } p++; }
  if (n < 6) return;
  level = atoi(f[0]) / 10.0; peak = atoi(f[1]) / 10.0; clip = atoi(f[2]); rec = atoi(f[3]); rate = atol(f[4]);
  strncpy(name, f[5], sizeof name - 1); name[sizeof name - 1] = 0;
  lastFrame = millis();
  if (level > SILENT_DB || !loudAt) loudAt = lastFrame;   // first frame starts the 3 s clock
}

void setup() {
  Serial.setRxBufferSize(1024);   // a frame push takes ~30 ms; lines wait here meanwhile
  Serial.begin(115200);
  if (!panel->begin()) Serial.println("display init failed");
  panel->fillScreen(RGB565_BLACK);
  panel->setBrightness(BRIGHTNESS);
  fb = (uint16_t *)heap_caps_malloc(W * H * 2, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT);
  if (!fb) {   // PSRAM switched off in the build settings: say so on the screen
    panel->setTextColor(RGB565_RED); panel->setTextSize(3);
    panel->setCursor(90, 200); panel->print("PSRAM is off.");
    panel->setCursor(90, 240); panel->print("Build with");
    panel->setCursor(90, 280); panel->print("OPI PSRAM.");
    for (;;) delay(1000);
  }
  draw();
  panel->draw16bitRGBBitmap(0, 0, fb, W, H);
}

uint32_t lastDraw = 0, drawnFrame = 0;
void loop() {
  while (Serial.available()) {
    char ch = Serial.read();
    if (ch == '\n') parseLine();
    else if (ch != '\r' && len < (int)sizeof lineBuf - 1) lineBuf[len++] = ch;
  }
  uint32_t now = millis();
  // redraw for every new frame (at most 25 a second), and twice a second otherwise for the timeouts
  if ((lastFrame != drawnFrame && now - lastDraw >= 40) || now - lastDraw >= 500) {
    lastDraw = now; drawnFrame = lastFrame;
    draw();
    panel->draw16bitRGBBitmap(0, 0, fb, W, H);
  }
}
